{
  "name": "thoughtbridge-runner",
  "version": "0.1.2",
  "description": "Self-hosted bridge-it runner - turns ThoughtBridge thoughts into pull requests with Claude Code",
  "type": "module",
  "bin": {
    "thoughtbridge-runner": "src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
